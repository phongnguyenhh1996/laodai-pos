# Lấy từ `npx supabase status` sau khi `npx supabase start`
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Chỉ dùng cho test DB / Cypress task (không bao giờ đưa vào bundle)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Edge Function gửi Telegram tới đây; khi test trỏ tới mock
TELEGRAM_API_BASE=http://host.docker.internal:8787
TELEGRAM_BOT_TOKEN=test-token
