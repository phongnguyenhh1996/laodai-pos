{
  "name": "laodai-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "start-server-and-test 'npm run e2e:serve' 'http-get://localhost:4173|http-get://localhost:8787/__health' 'cypress run'",
    "test:all": "npm run test && npm run test:db && npm run test:e2e",
    "e2e:serve": "npm run build && concurrently -k -n mock,app \"node tests/telegram-mock/server.mjs\" \"npm run preview\"",
    "telegram:mock": "node tests/telegram-mock/server.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "dexie": "^4.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cypress": "^13.17.0",
    "dotenv": "^16.6.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^25.0.1",
    "pg": "^8.23.1",
    "postcss": "^8.4.49",
    "start-server-and-test": "^2.0.8",
    "supabase": "^3.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "cypress@13.17.0": true,
    "esbuild@0.21.5": true
  }
}
